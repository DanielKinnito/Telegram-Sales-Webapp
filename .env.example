# ==============================================================================
# Telegram Sales WebApp & Notion CRM Environment Variables
# ==============================================================================

# Server Port (Render sets PORT automatically, defaults to 3000)
PORT=3000

# Telegram Bot Configuration (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_YourBotTokenHere

# Notion Integration API Secret (from notion.so/profile/integrations)
NOTION_API_KEY=ntn_your_notion_internal_integration_token
NOTION_PARENT_PAGE_ID=your_parent_notion_page_id

# Notion Database IDs (Provisioned via `npm run setup:notion` or manual)
NOTION_SALES_REPS_DB_ID=your_sales_reps_database_id
NOTION_ACCOUNTS_DB_ID=your_accounts_database_id
NOTION_DEALS_DB_ID=your_deals_database_id
NOTION_CONTACTS_DB_ID=your_contacts_database_id
NOTION_SALES_LOGS_DB_ID=your_sales_logs_database_id
NOTION_QUEUE_DB_ID=your_round_robin_queue_database_id

# Telegram Manager Alert Chat IDs (comma-separated Telegram numeric User IDs)
TELEGRAM_MANAGER_CHAT_IDS=123456789,987654321

# WebApp URL (Deployed URL for Telegram Mini App Menu Button)
WEBAPP_URL=https://your-telegram-sales-webapp.onrender.com

# Storage Provider (Optional / Adapter Pattern for Receipts)
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key
SUPABASE_BUCKET_NAME=payment-proofs

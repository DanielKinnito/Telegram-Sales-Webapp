# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment variables & secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Production Build Artifacts
dist/
*/dist/
build/
*/build/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage & tooling caches
coverage/
.nyc_output/
.vitest/
.cache/
.vite/

# Local Utilities, Binaries & Tunnel executables
*.exe
tools/
backend/tools/

# Editor & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
